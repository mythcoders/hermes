<div id="<%= dom_id profile %>">
  <p>
    <strong>Sender:</strong>
    <%= profile.sender_id %>
  </p>

  <p>
    <strong>Name:</strong>
    <%= profile.name %>
  </p>

  <p>
    <strong>State:</strong>
    <%= profile.state %>
  </p>

  <p>
    <strong>Regex:</strong>
    <%= profile.regex %>
  </p>

  <p>
    <strong>Reroute address:</strong>
    <%= profile.reroute_address %>
  </p>

  <p>
    <strong>Reply to address:</strong>
    <%= profile.reply_to_address %>
  </p>

</div>
