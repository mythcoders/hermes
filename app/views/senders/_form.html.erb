<%= form_with(model: sender) do |form| %>
  <%= render ErrorMessagesComponent.new(sender) %>

  <div>
    <%= form.label :name, style: "display: block" %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :state, style: "display: block" %>
    <%= form.text_field :state %>
  </div>

  <div>
    <%= form.label :address, style: "display: block" %>
    <%= form.email_field :address %>
  </div>

  <div>
    <%= form.label :key, style: "display: block" %>
    <%= form.text_field :key %>
  </div>

  <div>
    <%= form.label :secret, style: "display: block" %>
    <%= form.text_field :secret %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
